{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "types": ["node", "bun"],
        "skipLibCheck": true,
        // scripts/ladder.ts pulls src/lib/ai/selfplay/* (which imports the
        // engine via @convex/…), so this project needs the same alias map as
        // tsconfig.app.json.
        "paths": {
            "~/*": ["./src/*"],
            "@/*": ["./src/*"],
            "@convex/*": ["./convex/*"]
        },

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true
    },
    "include": ["scripts"],
    "exclude": ["scripts/__tests__"]
}
