{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Task|Agent|Skill|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/timing-log.sh pre"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Task|Agent|Skill|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/timing-log.sh post"
                    }
                ]
            }
        ]
    }
}
