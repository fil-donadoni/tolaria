{
    "enabledPlugins": {
        "superpowers@claude-plugins-official": false
    },
    "skillOverrides": {
        "convex-create-component": "name-only",
        "convex-migration-helper": "name-only",
        "convex-performance-audit": "name-only",
        "convex-quickstart": "name-only",
        "convex-setup-auth": "name-only",
        "code-review": "off",
        "grill-with-docs": "off",
        "grilling": "off",
        "handoff": "off",
        "implement": "off",
        "prototype": "off",
        "research": "off",
        "resolving-merge-conflicts": "off",
        "tdd": "off",
        "teach": "off",
        "teach-me": "off",
        "triage": "off",
        "wayfinder": "off",
        "write-a-skill": "off"
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Task|Agent|Skill|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/timing-log.sh pre"
                    }
                ]
            },
            {
                "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-guard.sh"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/claim-ledger.sh"
                    }
                ]
            },
            {
                "matcher": "Agent",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/spawn-guard.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Task|Agent|Skill|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/timing-log.sh post"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-origin.sh"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/claim-sweep.sh"
                    }
                ]
            }
        ]
    }
}
