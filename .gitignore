# Claude Code runtime lock (per-session: sessionId/pid). Not shared config.
.claude/scheduled_tasks.lock

# ladder run corpora (issue #1924) — reproducible from baseSeed, never committed;
# the durable record is the verdict block pasted into the PR
ladder-runs/

# list-to-cards staging output (regenerated; lockfile data/card-index.json IS committed)
data/worklists/*.out/
data/worklists/*.resolved.jsonl
# Full Catalogue (ADR 0080). `data/` holds the generator's primary output and
# stays ignored; `public/data/` is the asset the CLIENT fetches and IS COMMITTED
# — the production build must not depend on a Scryfall bulk download. Refresh it
# with `bun run catalogue:build` when a set ships.
data/full-catalogue.json.gz
# Oracle corpus cache (ADR 0105). The reduced Scryfall `oracle_cards` bulk —
# ~24 MB of third-party data that changes weekly. The repo's source of truth is
# the LOCKFILE it produces (data/oracle-compiled.json, committed) and the PIN
# that identifies it (data/oracle-corpus.pin.json, committed); the input itself
# is regenerable with `bun run oracle:corpus`.
data/oracle-corpus.json.gz
.claude/telemetry/
# Subagent receipts (issue #2182) — batch-scoped run artifacts, not source. The
# durable record of a batch is the merged PRs; these are the telemetry the
# merge-train (#2185) and the scorecard (#2187) read while the run is alive.
.claude/receipts/
