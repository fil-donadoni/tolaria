{
    "name": "tolaria",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "check:ts": "tsc -b --noEmit",
        "check:ids": "node scripts/check-scryfall-ids.mjs",
        "check:index": "bun scripts/check-card-index.ts",
        "check:stubs": "bun scripts/check-stub-coverage.ts",
        "test": "bun scripts/gate.ts heavy 'bun run test:app && bun run test:bot'",
        "test:app": "bun scripts/gate.ts heavy 'vitest run --project node --project jsdom'",
        "test:bot": "bun scripts/gate.ts heavy 'vitest run --project bot-node --project bot-jsdom'",
        "test:watch": "vitest",
        "test:blade": "BLADE_TIER=must vitest run --config vitest.blade.config.ts",
        "test:blade:stretch": "BLADE_TIER=stretch vitest run --config vitest.blade.config.ts",
        "selfplay": "SELFPLAY=1 vitest run src/lib/ai/selfplay/harness.bot.test.ts",
        "check:all": "bun scripts/gate.ts heavy 'bun run check:all:inner'",
        "check:all:inner": "(bun run format:check || (printf '\\033[31m✗ Formatting drift — run: bun run format\\033[0m\\n' && exit 1)) && bun run lint && bun run check:ts && bun run check:ids && bun run check:index && bun run check:stubs && printf '\\033[32m✓ All checks passed\\033[0m\\n' || (printf '\\033[31m✗ Checks failed\\033[0m\\n' && exit 1)",
        "preview": "vite preview",
        "prepare": "husky",
        "ralph": "npx tsx .sandcastle/main.ts",
        "ralph:single": "npx tsx .sandcastle/main.ts 1"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.111.0",
        "@auth/core": "^0.37.0",
        "@base-ui/react": "^1.3.0",
        "@convex-dev/auth": "^0.0.92",
        "@dnd-kit/helpers": "0.4.0",
        "@dnd-kit/react": "^0.4.0",
        "@fontsource-variable/geist": "^5.2.8",
        "@sentry/react": "^10.59.0",
        "@tailwindcss/vite": "^4.2.1",
        "@tanstack/react-router": "^1.169.2",
        "@tanstack/react-router-devtools": "^1.166.13",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "convex": "^1.32.0",
        "keyrune": "^3.19.0",
        "lucide-react": "^0.577.0",
        "motion": "^12.40.0",
        "pixi-filters": "^6.1.5",
        "pixi.js": "^8.19.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-json-tree": "^0.20.0",
        "shadcn": "^4.0.8",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.1",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@ai-hero/sandcastle": "^0.5.11",
        "@eslint/js": "^9.39.4",
        "@rolldown/plugin-babel": "^0.2.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/bun": "^1.3.14",
        "@types/node": "^24.12.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jsdom": "^29.0.2",
        "lint-staged": "^17.0.5",
        "prettier": "^3.8.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^8.0.0",
        "vitest": "^4.1.2"
    }
}
