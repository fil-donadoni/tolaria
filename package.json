{
    "name": "tolaria",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "agents:build": "bun scripts/build-agents-md.ts",
        "build": "bun run catalogue:ensure && tsc -b && vite build",
        "catalogue:build": "node scripts/fetch-full-catalogue.mjs",
        "catalogue:ensure": "node scripts/ensure-full-catalogue.mjs",
        "check:all": "bun scripts/gate.ts heavy 'bun run check:all:inner'",
        "check:all:inner": "(bun run format:check || (printf '\\033[31m✗ Formatting drift — run: bun run format\\033[0m\\n' && exit 1)) && bun run lint && bun run check:ts && bun run check:index && bun run check:stubs && bun run check:oracle && bun run check:bundle && bun run check:convex-bundle && printf '\\033[32m✓ All checks passed\\033[0m\\n' || (printf '\\033[31m✗ Checks failed\\033[0m\\n' && exit 1)",
        "check:bundle": "bun scripts/check-bundle-size.ts",
        "check:convex-bundle": "bun scripts/check-convex-bundle-size.ts",
        "check:docs": "bun scripts/gate.ts light 'bun run check:docs:inner'",
        "check:docs:inner": "bun run format:check && bun run cr:lint && vitest run --project node scripts/__tests__/action-space.test.ts scripts/__tests__/adr-index.test.ts scripts/__tests__/agents-md-drift.test.ts scripts/__tests__/bot-globs.test.ts scripts/__tests__/destructive-data-recipes.test.ts scripts/__tests__/findings.test.ts scripts/__tests__/project-skills.test.ts scripts/__tests__/resident-context-budget.test.ts",
        "check:guards": "TOLARIA_BOT_FAST=1 vitest run --project bot-node --project bot-dom && vitest run --project node --project dom && bun run cr:lint",
        "check:index": "bun scripts/check-card-index.ts",
        "check:lane": "bun scripts/check-lane.ts",
        "check:oracle": "bun scripts/check-oracle-lockfile.ts",
        "check:pr": "bun scripts/gate.ts light 'bun run check:all:inner && bun run check:guards'",
        "check:stubs": "bun scripts/check-stub-coverage.ts",
        "check:ts": "tsc -b --noEmit",
        "check:ui": "bun scripts/ui-gate/index.ts",
        "cr": "bun scripts/cr.ts",
        "cr:check": "bun scripts/cr.ts check",
        "cr:lint": "bun scripts/check-cr-citations.ts",
        "cr:sync": "bun scripts/cr.ts sync",
        "dev": "bun run catalogue:ensure && vite",
        "docs:ship": "bun scripts/docs-lane.ts ship",
        "findings": "bun scripts/findings.ts",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "gate:who": "bun scripts/gate.ts who",
        "health:main": "bun scripts/health-main.ts",
        "health:status": "bun scripts/health-main.ts --status",
        "ladder": "bun scripts/ladder.ts",
        "land": "bun scripts/land.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "loop:afk": "sh scripts/loop-handoff.sh",
        "loop:doctor": "bun scripts/loop-doctor.ts",
        "loop:drain": "sh scripts/loop-drain.sh",
        "loop:scorecard": "bun scripts/loop-scorecard.ts",
        "loop:status": "bun scripts/loop-status.ts",
        "markers:lint": "bun scripts/check-marker-liveness.ts",
        "oracle:behavioural": "bun scripts/oracle-behavioural.ts",
        "oracle:compile": "bun scripts/oracle-compile.ts",
        "oracle:corpus": "bun scripts/oracle-corpus.ts",
        "oracle:index": "bun scripts/oracle-index-backfill.ts",
        "oracle:legality": "bun scripts/oracle-legality.ts",
        "oracle:pool": "bun scripts/oracle-pool.ts",
        "oracle:report": "bun scripts/oracle-report.ts",
        "oracle:retire": "bun scripts/oracle-retire.ts",
        "oracle:triage": "bun scripts/oracle-baseline-triage.ts",
        "prepare": "husky",
        "preview": "vite preview",
        "queue:lint": "bun scripts/queue-lint.ts",
        "queue:plan": "bun scripts/queue-plan.ts",
        "queue:train": "bun scripts/train-order.ts",
        "review:receipt": "bun scripts/write-review-receipt.ts",
        "seed:backlog": "bun scripts/seed-scenario-backlog.ts",
        "seed:scenario": "bun scripts/seed-scenario.ts",
        "selfplay": "SELFPLAY=1 vitest run src/lib/ai/selfplay/harness.bot.test.ts",
        "telemetry:context": "bun scripts/telemetry-context.ts",
        "telemetry:dash": "bun scripts/telemetry-serve.ts",
        "telemetry:ingest": "bun scripts/telemetry-ingest.ts",
        "telemetry:latency": "bun scripts/telemetry-latency.ts",
        "test": "bun scripts/gate.ts heavy 'bun run test:app && bun run test:bot && bun run test:blade'",
        "test:app": "bun scripts/gate.ts heavy 'vitest run --project node --project dom'",
        "test:blade": "BLADE_TIER=must vitest run --config vitest.blade.config.ts",
        "test:blade:stretch": "BLADE_TIER=stretch vitest run --config vitest.blade.config.ts",
        "test:bot": "bun scripts/gate.ts heavy 'vitest run --project bot-node --project bot-dom'",
        "test:watch": "vitest",
        "usage:window": "bun scripts/usage-window.ts",
        "verify:ui-receipt": "bun scripts/ui-gate/verify-receipt.ts",
        "worktree:init": "bun scripts/bootstrap-worktree.ts",
        "wt:docs": "bun scripts/docs-lane.ts new",
        "wt:gc": "bun scripts/worktree-gc.ts"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.111.0",
        "@auth/core": "^0.37.0",
        "@base-ui/react": "^1.3.0",
        "@convex-dev/auth": "^0.0.92",
        "@dnd-kit/helpers": "0.4.0",
        "@dnd-kit/react": "^0.4.0",
        "@fontsource-variable/geist": "^5.2.8",
        "@sentry/react": "^10.59.0",
        "@tailwindcss/vite": "^4.2.1",
        "@tanstack/react-router": "^1.169.2",
        "@tanstack/react-router-devtools": "^1.166.13",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "convex": "^1.32.0",
        "keyrune": "^3.19.0",
        "lucide-react": "^0.577.0",
        "motion": "^12.40.0",
        "pixi-filters": "^6.1.5",
        "pixi.js": "^8.19.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-json-tree": "^0.20.0",
        "shadcn": "^4.0.8",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.1",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@ai-hero/sandcastle": "^0.5.11",
        "@eslint/js": "^9.39.4",
        "@rolldown/plugin-babel": "^0.2.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/bun": "^1.3.14",
        "@types/node": "^24.12.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.0",
        "axe-core": "^4.13.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "happy-dom": "^20.11.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "playwright": "^1.62.1",
        "prettier": "^3.8.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^8.0.0",
        "vitest": "^4.1.2"
    }
}
