convex/_generated

# Convex local-deployment state. Ignored by `.convex/.gitignore`, but prettier
# only reads the ROOT `.gitignore` — without this entry a local `format:check`
# goes red on a file CI (a fresh checkout) never even sees.
.convex

# Vendored agent skills, installed by `npx convex ai-files install` and
# committed verbatim. Third-party output — reformatting it would only fight the
# next install. Their drift is what turned the `quality` job red for six weeks.
.agents
skills-lock.json

# Worklist importer staging output (ADR 0041) — regenerable, gitignored
data/worklists/*.out

# Per-machine Claude Code permissions. Ignored via the user's GLOBAL git ignore
# (`~/.config/git/ignore`), which prettier cannot see at all — it reads only the
# repo's root `.gitignore`. CI checks out a tree where this file doesn't exist,
# so the drift is invisible there and red on every local `check:pr`.
.claude/settings.local.json

# Oracle compiler lockfile (ADR 0105). Generated by `bun run oracle:compile`
# with a deterministic serializer that puts ONE ROW PER LINE — 35,000 rows
# formatted by prettier would be 400,000 lines and every regeneration an
# unreadable diff, which defeats the reason the file is committed at all
# (a card moving ready -> unparsed must be one changed line in review).
data/oracle-compiled.json
