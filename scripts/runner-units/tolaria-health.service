# The health runner as a systemd user service (Huawei, issue #5467): one tick
# of `scripts/health-runner.ts` — fetch the base, apply the cadence rule, and
# on a fire run health-main and write its verdict through the store. Started
# by tolaria-health.timer. Install: docs/guides/huawei-runner.md § The health
# runner. __REPO__ and __MISE__ are substituted at install time.
[Unit]
Description=Tolaria health runner: one cadence tick, batch health on a fire
After=network-online.target tolaria-convex.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO__
# `mise exec` resolves the checkout's toolchain (Node at the repo's pin, bun
# from the user's global config), the same as tolaria-convex.service.
ExecStart=__MISE__ exec -- bun scripts/health-runner.ts
# Optional: TOLARIA_NOTIFY_CMD (the push notification) and any other
# variable the runner reads. A missing file is not an error.
EnvironmentFile=-%h/.config/tolaria/runner.env
StandardInput=null
# A whole batch run on the Huawei, offline gates plus a walk, with room; past
# MAX_PENDING_MS (6 h) the MacBook has already run its own fallback.
TimeoutStartSec=6h
# The cgroup kill: health-main's worktree gates die with the unit.
KillMode=control-group
Environment=TOLARIA_OWNER=unit:tolaria-health.service
