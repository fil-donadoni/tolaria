# Fires tolaria-health.service every 5 minutes (issue #5467). A tick that
# holds costs one fetch and one store read; a tick that fires runs until
# health is done, and systemd starts no second one meanwhile.
[Unit]
Description=Tolaria health runner: a cadence tick every 5 minutes

[Timer]
OnCalendar=*:0/5
AccuracySec=30s
Persistent=false
Unit=tolaria-health.service

[Install]
WantedBy=timers.target
