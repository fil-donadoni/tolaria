<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The land-runner's launchd agent (MacBook ONLY) — the one merger, kept alive
  (issue #5469). The alternative to a detached `bun run land:runner`, the
  same process unsupervised; the runner's lock keeps one of them. Install per
  docs/guides/huawei-runner.md § Install on the MacBook. __REPO__,
  __BUN__, __NODE_BIN__ and __HOME__ are substituted at install time. Restarted only after a CRASH: SIGTERM (`--disarm`)
  makes it exit 0 after the landing in flight, which launchd leaves stopped;
  `ExitTimeOut` gives that landing an hour before launchd's SIGKILL.
  `RunAtLoad` starts it at login: KeepAlive/SuccessfulExit only restarts after
  a crash, so without it a reboot leaves the runner unloaded (issue #5669).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tolaria.land-runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BUN__</string>
        <string>__REPO__/scripts/land-runner.ts</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>ExitTimeOut</key>
    <integer>3600</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__HOME__/.bun/bin:__NODE_BIN__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.cache/tolaria/land-runner/agent.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.cache/tolaria/land-runner/agent.log</string>
</dict>
</plist>
