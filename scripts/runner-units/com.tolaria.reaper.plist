<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The reaper's launchd agent (MacBook) — one sweep every 2 minutes
  (issue #5470). Install: docs/guides/huawei-runner.md § Install on the
  MacBook. __REPO__, __BUN__, __NODE_BIN__ and __HOME__ are substituted at install
  time (node is not on launchd's default PATH).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tolaria.reaper</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BUN__</string>
        <string>__REPO__/scripts/reaper.ts</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>StartInterval</key>
    <integer>120</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__NODE_BIN__:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TOLARIA_OWNER</key>
        <string>unit:com.tolaria.reaper</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.cache/tolaria/reaper/agent.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.cache/tolaria/reaper/agent.log</string>
</dict>
</plist>
