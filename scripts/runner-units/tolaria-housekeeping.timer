# Fires tolaria-housekeeping.service hourly (issue #5592). The script walks the
# PRs merged since its watermark, so a missed or late tick loses nothing.
[Unit]
Description=Tolaria housekeeping: hourly

[Timer]
OnCalendar=*:17
AccuracySec=1min
Persistent=false
Unit=tolaria-housekeeping.service

[Install]
WantedBy=timers.target
