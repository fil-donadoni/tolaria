# Fires tolaria-nightly.service once a night at 03:40 (issue #5592). The health
# runner ticks every 5 minutes at any hour, so no hour is free of it; gate.ts
# queues the nightly's CPU-bound steps behind a running health. Persistent:
# a night the Huawei was off runs at boot. The script decides itself whether
# the weekly audits are due.
[Unit]
Description=Tolaria nightly: once a night

[Timer]
OnCalendar=*-*-* 03:40:00
AccuracySec=5min
Persistent=true
Unit=tolaria-nightly.service

[Install]
WantedBy=timers.target
