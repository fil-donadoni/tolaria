# The nightly Bot upkeep as a systemd user service (Huawei, issue #5592):
# `scripts/health-nightly.ts` — the Bot Findings refresh (bot:reach,
# seed:bot-findings, gaps:sync) when the Bot moved, and the weekly robustness
# and pick-agreement audits when due (ADR 0154 §6, issue #5458). Started by
# tolaria-nightly.timer. Install: docs/guides/huawei-runner.md § The crons.
# __REPO__ and __MISE__ are substituted at install time.
[Unit]
Description=Tolaria nightly: Bot Findings refresh, weekly audits when due
After=network-online.target tolaria-convex.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO__
ExecStart=__MISE__ exec -- bun scripts/health-nightly.ts
EnvironmentFile=-%h/.config/tolaria/runner.env
StandardInput=null
# The full audits plus a bot:reach, queued behind gate.ts with room to spare.
TimeoutStartSec=6h
KillMode=control-group
Environment=TOLARIA_OWNER=unit:tolaria-nightly.service
