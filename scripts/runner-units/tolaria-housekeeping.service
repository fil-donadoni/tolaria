# The hourly housekeeping cron as a systemd user service (Huawei, issue #5592):
# `scripts/housekeeping.ts` — the GitHub-bound post-merge steps `land` no longer
# runs (gaps:sync, grammar residue, release-claim label, umbrella detach; ADR
# 0154 §5, issue #5457). Started by tolaria-housekeeping.timer. It fast-forwards
# the primary checkout and pushes gaps:sync's allowlist to the base branch, so
# the checkout needs push credentials. Install: docs/guides/huawei-runner.md
# § The crons. __REPO__ and __MISE__ are substituted at install time.
[Unit]
Description=Tolaria housekeeping: post-merge GitHub steps, hourly
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO__
# `mise exec` resolves the checkout's toolchain, the same as tolaria-health.service.
ExecStart=__MISE__ exec -- bun scripts/housekeeping.ts
# Optional: GH_TOKEN / push credentials and any other variable the script
# reads. A missing file is not an error.
EnvironmentFile=-%h/.config/tolaria/runner.env
StandardInput=null
# A run that outlives an hour is stuck on the network; the next tick retries.
TimeoutStartSec=50min
# The cgroup kill: gaps:sync's children die with the unit.
KillMode=control-group
Environment=TOLARIA_OWNER=unit:tolaria-housekeeping.service
