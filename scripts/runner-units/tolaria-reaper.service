# The reaper's systemd user service (Huawei) — one sweep, started by
# tolaria-reaper.timer every 2 minutes (issue #5470). Install:
# docs/guides/huawei-runner.md § Install on the Huawei. __REPO__ and __BUN__
# are substituted at install time.
[Unit]
Description=Tolaria reaper: one sweep of abandoned tooling process trees

[Service]
Type=oneshot
WorkingDirectory=__REPO__
Environment=TOLARIA_OWNER=unit:tolaria-reaper.service
ExecStart=__BUN__ __REPO__/scripts/reaper.ts
# The cgroup kill: anything this unit leaves behind dies with it.
KillMode=control-group
TimeoutStartSec=120
