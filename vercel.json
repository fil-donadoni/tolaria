{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "bunx convex codegen --typecheck disable && bunx convex deploy --cmd 'bun run build' && bun run seed:preset:deploy && bun run prints:sync:deploy",
    "installCommand": "bun install",
    "git": {
        "deploymentEnabled": {
            "main": true,
            "**": false
        }
    },
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/diag/relay",
            "destination": "https://o4505113193218048.ingest.us.sentry.io/api/4511609765691393/envelope/"
        },
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}
