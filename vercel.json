{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "bunx convex codegen --typecheck disable && bunx convex deploy --cmd 'bun run build'",
    "installCommand": "bun install",
    "git": {
        "deploymentEnabled": {
            "main": true,
            "**": false
        }
    },
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
