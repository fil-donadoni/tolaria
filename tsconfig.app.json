{
    "compilerOptions": {
        "incremental": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2023",
        "useDefineForClassFields": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        // `node` because `@convex/*` lets this program reach Convex server
        // modules, which read `process.env` (issue #4949) — guarded by
        // scripts/__tests__/tsconfig-convex-node-types.test.ts.
        "types": ["vite/client", "node"],
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,

        "paths": {
            "~/*": ["./src/*"],
            "@/*": ["./src/*"],
            "@convex/*": ["./convex/*"]
        }
    },
    "include": [
        "src",
        "convex/_generated",
        "convex/cards/types.ts",
        "convex/gre/types.ts",
        "convex/gre/constants.ts"
    ]
}
